* text=auto
*.cs text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.meta text eol=lf
*.unity text eol=lf
*.prefab text eol=lf
*.mat text eol=lf
*.anim text eol=lf
*.controller text eol=lf
*.asmdef text eol=lf
*.inputactions text eol=lf
# Ordinary binary assets. Unity .asset files can be text OR binary:
# leave .asset on automatic detection.
*.png binary
*.jpg binary
*.jpeg binary
*.ogg binary
*.mp3 binary
# Large source art / uncompressed audio. Install Git LFS before first commit.
*.[pP][sS][dD] filter=lfs diff=lfs merge=lfs -text
*.[kK][rR][aA] filter=lfs diff=lfs merge=lfs -text
*.[wW][aA][vV] filter=lfs diff=lfs merge=lfs -text
*.[fF][lL][aA][cC] filter=lfs diff=lfs merge=lfs -text
*.[mM][pP]4 filter=lfs diff=lfs merge=lfs -text
